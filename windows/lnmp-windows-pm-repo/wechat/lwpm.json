{
  "name": "wechat",
  "description": "Free messaging and calling app",
  "version": "latest",
  "pre-version": "latest",
  "homepage": "https://weixin.qq.com/",
  "bug": "",
  "github": "",
  "releases": "",
  "url": "https://dldir1v6.qq.com/weixin/Universal/$(if($IsMacOs){echo Mac/WeChatMac.dmg}else{echo Windows/WeChatWin.exe})",
  "command": "${env:ProgramFiles}\\Tencent\\WeChat\\WeChat.exe",
  "scripts": {
    "platform-reqs": [
      "if(!($IsWindows -or $IsMacOs)){echo $False}"
    ],
    "install": "Start-Process -FilePath $filename -wait",
    "uninstall": "& ${env:ProgramFiles}\\Tencent\\WeChat\\Uninstall.exe",
    "version": "echo ${VERSION}",
    "test": "if($IsWindows){& get-command ${env:ProgramFiles}\\Tencent\\Weixin\\Weixin.exe}"
  }
}
