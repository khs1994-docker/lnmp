  "url-mirror": "https://${env:GITHUB_MIRROR}/balena-io/etcher/releases/download/v${VERSION}/balenaEtcher-$(if($env:lwpm_os -eq 'windows'){echo win32-x64-${VERSION}.zip}else{echo darwin-x64-${VERSION}.zip})",
  "version": "2.1.2"
}
