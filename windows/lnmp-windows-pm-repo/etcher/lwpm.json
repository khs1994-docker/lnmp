{
  "description": "Flash OS images to SD cards & USB drives, safely and easily.",
  "github": "balena-io/etcher",
  "name": "etcher",
  "scripts": {
    "install": "_unzip $filename $unzipDesc\n# Start-Process -FilePath $filename -wait\n",
