{
  "name": "runsc",
  "platform": [
    {
      "architecture": "amd64",
      "os": "linux"
    }
  ],
  "scripts": {
    "dist": "_mkdir $env:LWPM_PKG_ROOT/dist\n\ncurl -L `\n  https://storage.googleapis.com/gvisor/releases/master/latest/x86_64/gvisor.tar.zstd `\n  -o $env:LWPM_PKG_ROOT/dist/gvisor.tar.zstd\n",
