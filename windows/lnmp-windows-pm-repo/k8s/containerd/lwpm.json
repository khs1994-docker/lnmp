{
  "hash-url": {
    "sha256": "https://github.com/containerd/containerd/releases/download/v${VERSION}/containerd-${VERSION}-${env:lwpm_os}-${env:lwpm_architecture}.tar.gz.sha256sum"
  },
  "name": "containerd",
  "path": [
    "C:\\bin"
  ],
  "platform": [
    {
      "os": "linux",
      "architecture": "amd64"
    },
    {
      "os": "linux",
      "architecture": "arm64"
    },
    {
      "os": "windows",
      "architecture": "amd64"
    }
  ],
  "pre-version": "2.2.0-beta.1",
  "scripts": {
    "dist": "_mkdir $env:LWPM_PKG_ROOT/dist/${env:lwpm_os}-${env:lwpm_architecture}\n\ncurl -L `\n  $url `\n  -o $env:LWPM_PKG_ROOT/dist/${env:lwpm_os}-${env:lwpm_architecture}/$filename\n",
    "install": "tar -zxvf $filename -C C:\\\n",
    "platform-reqs": "if($IsMacOs){echo $False}",
    "postinstall": "_mkdir C:\\bin\\containerd\ncontainerd.exe config default | Out-File \"C:\\bin\\containerd\\ctn.toml\" -Encoding ascii\n",
    "service": [
      "C:\\bin\\containerd.exe",
      "--log-level=debug",
      "--config=C:\\bin\\containerd\\ctn.toml"
    ]
  },
  "url": "https://github.com/containerd/containerd/releases/download/v${VERSION}/containerd-${VERSION}-${env:lwpm_os}-${env:lwpm_architecture}.tar.gz",
  "url-mirror": "https://${env:GITHUB_MIRROR}/containerd/containerd/releases/download/v${VERSION}/containerd-${VERSION}-${env:lwpm_os}-${env:lwpm_architecture}.tar.gz",
  "version": "2.2.0-beta.1"
}
