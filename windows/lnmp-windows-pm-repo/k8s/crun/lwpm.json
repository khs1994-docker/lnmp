{
  "name": "crun",
  "platform": [
    {
      "os": "linux",
      "architecture": "amd64"
    },
    {
      "os": "linux",
      "architecture": "arm64"
    }
  ],
  "scripts": {
    "dist": "_mkdir $env:LWPM_PKG_ROOT/dist/${env:lwpm_os}-${env:lwpm_architecture}\n\ncurl -L `\n  $url `\n  -o $env:LWPM_PKG_ROOT/dist/${env:lwpm_os}-${env:lwpm_architecture}/crun-${VERSION}-${env:lwpm_os}-${env:lwpm_architecture}\n\ncurl -L `\n  $url `\n  -o $env:LWPM_PKG_ROOT/dist/${env:lwpm_os}-${env:lwpm_architecture}/crun-${VERSION}-${env:lwpm_os}-${env:lwpm_architecture}-disable-systemd\n",
    "platform-reqs": "if(!$IsLinux){echo $False}"
  },
  "url": "https://github.com/containers/crun/releases/download/${VERSION}/crun-${VERSION}-${env:lwpm_os}-${env:lwpm_architecture}",
  "version": "1.23.1"
}
