{
  "name": "conmon",
  "platform": [
    {
      "os": "linux",
      "architecture": "amd64"
    },
    {
      "os": "linux",
      "architecture": "arm64"
    }
  ],
  "scripts": {
    "dist": "_mkdir $env:LWPM_PKG_ROOT/dist/${env:lwpm_os}-${env:lwpm_architecture}\n\ncurl -L `\n  $url `\n  -o $env:LWPM_PKG_ROOT/dist/${env:lwpm_os}-${env:lwpm_architecture}/conmon `\n|| curl -L `\n  $url-${VERSION} `\n  -o $env:LWPM_PKG_ROOT/dist/${env:lwpm_os}-${env:lwpm_architecture}/conmon `\n",
    "platform-reqs": "if(!$IsLinux){echo $False}"
  },
  "url": "https://github.com/containers/conmon/releases/download/v${VERSION}/conmon.${env:lwpm_architecture}",
  "url-mirror": "https://${env:GITHUB_MIRROR}/containers/conmon/releases/download/v${VERSION}/conmon.${env:lwpm_architecture}",
  "version": "2.1.13"
}
