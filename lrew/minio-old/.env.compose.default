# 请不要修改此文件，修改请在该目录下新建 .env.compose 文件，并复制需要修改的变量到 .env.compose 文件中进行修改
# 或者添加到该目录 .env.compose.${LNMP_ENV} 文件中进行修改

# https://github.com/minio/minio/releases
LNMP_MINIO_OLD_VERSION=RELEASE.2022-10-24T18-35-07Z

# https://docs.min.io/docs/minio-quickstart-guide.html

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_REGION_NAME=us-east-1
MINIO_BROWSER=on
MINIO_DOMAIN=

LNMP_LREW_MINIO_IMAGE=minio/minio
