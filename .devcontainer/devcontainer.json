{
  // https://code.visualstudio.com/docs/remote/containers#_devcontainerjson-reference
  // fix me
  "name": "lnmp",

  // The order of the files is important since later files override previous ones
  "dockerComposeFile": [
    // "../lrew/workspace/docker-compose.yml",
    // "../lrew/workspace/compose.override.yml"
    "../compose-up.yaml"
  ],

  // fix me
  "service": "workspace",
  "runServices": [
    "workspace"
  ],
  // fix me 与 docker-workspace.yml 中的路径一致
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose", // none stopCompose
  // 配置 features 可能由于网络问题，无法完成镜像 build 而导致失败
  // "features": {
  //   "ghcr.io/devcontainers/features/git": {
  //   }
  // },
  "customizations": {
    "vscode": {
      "extensions": [
        "xdebug.php-debug",
        "editorconfig.editorconfig",
        // php doc
        "neilbrayfield.php-docblocker",
        // 提供右键导入命名空间等功能
        "mehedidracula.php-namespace-resolver",
        // Laravel 代码补全
        "laravel.vscode-laravel",
        "getpsalm.psalm-vscode-plugin",
        // 代码补全
        "bmewburn.vscode-intelephense-client",
        "recca0120.vscode-phpunit"
      ],
      "settings": {
        // If you are using an Alpine-based image, change this to /bin/ash
        // "terminal.integrated.shell.linux": "/bin/bash"
      }
    }
  }
  // [Optional] If you are using SSH keys w/Git, copy them and set correct permissions
